{
  "name": "tripbranch-backend",
  "private": true,
  "version": "0.1.0",
  "description": "Thin npm script wrapper around the Python/FastAPI backend so the root workspace can orchestrate it uniformly.",
  "scripts": {
    "dev": "node scripts/venv-run.mjs uvicorn app.main:app --reload --port 8000",
    "lint": "node scripts/venv-run.mjs ruff check .",
    "format": "node scripts/venv-run.mjs ruff format .",
    "test": "node scripts/venv-run.mjs pytest",
    "export-openapi": "node scripts/venv-run.mjs python scripts/export_openapi.py"
  }
}
