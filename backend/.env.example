# Application environment: local | development | production
APP_ENV=local

# Provider selection: 공통 기본값은 PROVIDER_MODE, 개별 값은 선택적 override.
PROVIDER_MODE=fake
LLM_PROVIDER=fake
WEATHER_PROVIDER=
PLACE_PROVIDER=
GEOCODING_PROVIDER=
CONCENTRATION_PROVIDER=
HOLIDAY_PROVIDER=

# Only required when the corresponding *_PROVIDER above is set to "real".
LLM_API_KEY=
WEATHER_API_KEY=
TOUR_API_SERVICE_KEY=
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

# Supabase server-only persistence. Never expose the Service Role key to frontend code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Place synchronization defaults (Seoul Jongno-gu).
PLACE_SYNC_PAGE_SIZE=100
PLACE_SYNC_DETAIL_CONCURRENCY=5
PLACE_SYNC_DETAIL_TTL_DAYS=30
PLACE_SYNC_AREA_CODE=11
PLACE_SYNC_DISTRICT_CODE=110

# Real provider HTTP behavior (ignored by fake providers).
EXTERNAL_API_TIMEOUT_SECONDS=10
EXTERNAL_API_RETRY_COUNT=2

# Fake-provider-only knob: force a fixed weather condition (good | neutral | bad).
# Leave unset to let FakeWeatherProvider cycle/default to "neutral".
FAKE_WEATHER_CONDITION=neutral

# Fake-place-only knob: the "current time" recommendation logic sees when
# PLACE_PROVIDER=fake (see app/core/clock.py). ISO 8601, no timezone.
# Ignored when PLACE_PROVIDER=real (real time is used instead). Keeping this
# fixed makes Fake recommendation results reproducible regardless of when you
# actually run the app -- pick a weekday daytime so fake places are open.
FAKE_CURRENT_DATETIME=2026-07-15T14:00:00
