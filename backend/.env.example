# 애플리케이션 실행 환경: local | development | production
APP_ENV=local

# Provider 선택: 공통 기본값은 PROVIDER_MODE이며 개별 값으로 덮어쓸 수 있다.
PROVIDER_MODE=fake
LLM_PROVIDER=fake
WEATHER_PROVIDER=
PLACE_PROVIDER=
GEOCODING_PROVIDER=
CONCENTRATION_PROVIDER=
SEOUL_CITYDATA_PROVIDER=
HOLIDAY_PROVIDER=
# 도보 경로 Provider(카카오): fake | real
# 카카오맵 REST API를 활성화하고 REST API 키를 발급한 뒤 real로 변경한다.
# PROVIDER_MODE=real이어도 기본값은 fake로 유지된다 — 경로 API는 목적지 수만큼
# 호출하므로 비용이 커서, 이동수단마다 여기서 명시적으로 켠다.
TRAVEL_ROUTE_PROVIDER=fake
# 자동차 경로 Provider(네이버 지도 Directions 5): fake | real
# 공통값을 상속하지 않는다 — 도보와 벤더가 달라서, 상속시키면 카카오 키만 가진
# 설정이 네이버 키까지 요구하며 부팅에 실패한다. 켜려면 여기에 real을 적는다.
# NCP 콘솔에서 해당 Application에 Directions가 활성화되어 있어야 한다. 켜져 있지
# 않으면 게이트웨이는 통과하고 서비스가 403(본문 없음)을 준다.
TRAVEL_ROUTE_DRIVING_PROVIDER=fake
# 대중교통 경로 Provider(카카오): fake | real
# 도보와 같은 KAKAO_MAP_REST_API_KEY를 쓰지만 엔드포인트가 달라 호출량이 따로
# 늘어나므로 스위치를 따로 둔다. 요청에 출발 시각 파라미터가 없어 같은 구간은
# 언제 물어도 같은 값이 온다.
TRAVEL_ROUTE_TRANSIT_PROVIDER=fake
# 직선거리 fallback의 도보 예상시간 계산 속도(m/s).
WALKING_SPEED_MPS=1.2
# 자동차 fake의 직선거리 예상시간 계산 속도(m/s). 20km/h로, 검색 반경이 비도보
# 요청에 쓰는 가정과 같은 값이다. fake 값은 채점에 쓰이지 않는다.
DRIVING_SPEED_MPS=5.5
# 대중교통 fake도 같은 20km/h 가정을 쓴다 — 반경 산정이 비도보 요청을 이동수단으로
# 가르지 않기 때문이다.
TRANSIT_SPEED_MPS=5.5
# 도보·자동차·대중교통 경로 API 모두 목적지별 단건 호출이므로 동시 요청 수를 제한한다.
TRAVEL_ROUTE_MAX_CONCURRENCY=5

# 장소 후보별 상세·운영정보를 어디서 읽을지 고른다: supabase | tour_api
# - supabase: 미리 동기화된 places 테이블을 content_id로 한 번에 조회한다.
#             SUPABASE_URL / SUPABASE_SECRET_KEY가 필요하다.
# - tour_api: 후보마다 상세 API를 호출한다(기본값).
# 장소 후보 "검색"은 이 값과 무관하게 항상 PLACE_PROVIDER를 따른다.
# PLACE_PROVIDER가 fake이면 상세도 Fake Provider가 담당하므로 이 값은 무시된다.
PLACE_DETAILS_SOURCE=tour_api

# 빠른 구조화 판단(의도 분류·조건 추출) 모델. 기본값은 Lite로 비용·지연을 줄인다.
LLM_FAST_MODEL_NAME=gemini-3.5-flash-lite
# 빠른 모델 재시도 소진 시 사용할 대체 모델(쉼표 구분, 선택 사항)
LLM_FAST_FALLBACK_MODEL_NAMES=gemini-3.5-flash

# 사용자 답변·비교·일정 생성 모델. 문장 품질이 중요한 경로다.
LLM_GENERATION_MODEL_NAME=gemini-3.5-flash
# 생성 모델 재시도 소진 시 사용할 대체 모델(쉼표 구분, 선택 사항)
LLM_GENERATION_FALLBACK_MODEL_NAMES=gemini-3.5-flash-lite

# 음성 입력(음성→텍스트) 전용 Gemini 모델. 비우면 LLM_FAST_MODEL_NAME을 사용한다.
# 음성도 지원하는 Gemini 모델을 지정한다.
GEMINI_AUDIO_MODEL_NAME=

# LLM_MODEL_NAME / LLM_FALLBACK_MODEL_NAMES는 폐지됐다. 남아 있으면 부팅에서 막는다 —
# 값이 무시될 뿐 서버는 떠서, .env에 적힌 모델과 실제 호출되는 모델이 달라지기 때문이다.
# 위의 역할별 설정으로 옮긴다.

# 위의 각 Provider를 real로 설정했을 때만 필요한 인증 정보
LLM_API_KEY=
WEATHER_API_KEY=
TOUR_API_SERVICE_KEY=
# NAVER_MAP_*는 지오코딩과 자동차 경로(Directions)가 같이 쓴다. 두 하위 API가
# 같은 Application에 각각 활성화되어 있어야 한다.
# 서울시 실시간 도시데이터/상권현황 API. SEOUL_CITYDATA_PROVIDER=real일 때 필요하다.
SEOUL_OPEN_DATA_API_KEY=
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=
NAVER_LOCAL_SEARCH_CLIENT_ID=
NAVER_LOCAL_SEARCH_CLIENT_SECRET=
LOCAL_SEARCH_PROVIDER=fake

# 카카오맵 도보 경로 REST API 인증
# - KAKAO_MAP_REST_API_KEY: 카카오디벨로퍼스에서 발급한 REST API 키.
#   요청 시 `Authorization: KakaoAK {키}` 헤더로 사용하며 프론트엔드에 노출하지 않는다.
# 공식 단건 도보 경로 엔드포인트: https://dapi.kakao.com/v2/routing/walk
KAKAO_MAP_REST_API_KEY=

# Supabase 서버 전용 저장소 설정. Secret Key는 프론트엔드에 노출하지 않는다.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Package B의 State(세션 상태·이력·트레이스) 저장소 백엔드: memory | supabase
# - memory: 프로세스 메모리에 저장한다(기본값). 서버 재시작 시 소멸한다.
# - supabase: DB에 영구 저장한다. SUPABASE_URL / SUPABASE_SECRET_KEY가 필요하다.
STATE_STORE_BACKEND=memory

# 장소 동기화 기본값: 서울 종로구
PLACE_SYNC_PAGE_SIZE=100
PLACE_SYNC_DETAIL_CONCURRENCY=5
PLACE_SYNC_DETAIL_TTL_DAYS=30
PLACE_SYNC_AREA_CODE=11
PLACE_SYNC_DISTRICT_CODE=110

# 상세조회 호출 간 최소 간격(초). 0이면 간격을 두지 않는다.
# TourAPI는 초당 한도와 일일 한도를 따로 두는데, detailIntro2 응답이 100ms대라
# 동시성을 1로 낮춰도 초당 8회쯤 나가 초당 한도에 걸린다(2026-08-10 실측).
# 평소에는 0으로 두고, 전량 재조회(--force-details)처럼 대량 실행에서만 올려 쓴다.
# 예: PLACE_SYNC_DETAIL_MIN_INTERVAL_SECONDS=0.15  (초당 약 6~7회)
PLACE_SYNC_DETAIL_MIN_INTERVAL_SECONDS=0

# 실제 Provider의 HTTP 동작 설정이며 fake Provider에서는 사용하지 않는다.
# TourAPI/Naver/Supabase(장소 상세·상태 저장소 등) 조회에 적용된다 — 원래 짧게
# 끝나야 하는 단순 조회라 값을 너무 크게 잡으면 실패 시 사용자가 그만큼 오래
# 기다리게 된다.
EXTERNAL_API_TIMEOUT_SECONDS=10
EXTERNAL_API_RETRY_COUNT=2

# LLM(Gemini) 호출 전용 타임아웃(초). 비어 있으면 EXTERNAL_API_TIMEOUT_SECONDS를
# 그대로 쓴다. Gemini는 구조화 출력 생성 특성상 Tool/DB 조회보다 오래 걸릴 수
# 있어 EXTERNAL_API_TIMEOUT_SECONDS와 분리했다(2026-08-11) — Gemini 호출이 느려
# EXTERNAL_API_TIMEOUT_SECONDS를 올리면 TourAPI/Naver/Supabase까지 같이 오래
# 기다리게 되는 문제가 있었다.
# 예: LLM_API_TIMEOUT_SECONDS=25
LLM_API_TIMEOUT_SECONDS=

# 추천 파이프라인 후보 예산 (MVP 기본값, 필요 시 조정 가능)
RECOMMENDATION_RESULT_LIMIT=5
RECOMMENDATION_CANDIDATE_LIMIT=10

# Fake Provider가 내려줄 고정 날씨 "사실" — 기상청 코드를 그대로 쓴다(D-051).
# 판정(good/neutral/bad)은 D가 사용자 의도까지 보고 내리므로 여기서 지정하지 않는다.
# SKY: 1 맑음 / 3 구름많음 / 4 흐림, PTY: 0 없음 / 1 비 / 2 비눈 / 3 눈
# 기본값(4, 0)은 판정을 어느 쪽으로도 밀지 않는 중립 조합이다.
FAKE_WEATHER_SKY_CODE=4
FAKE_WEATHER_PRECIPITATION_TYPE=0

# PLACE_PROVIDER=fake일 때 추천 로직이 현재 시각으로 사용할 값
# app/core/clock.py에서 사용하며 시간대 없는 ISO 8601 형식으로 입력한다.
# PLACE_PROVIDER=real이면 실제 시각을 사용하므로 이 값은 무시된다.
# Fake 추천 결과를 재현할 수 있도록 장소가 운영 중인 평일 낮 시간으로 고정한다.
FAKE_CURRENT_DATETIME=2026-07-15T14:00:00
