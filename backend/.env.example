# 애플리케이션 실행 환경: local | development | production
APP_ENV=local

# Provider 선택: 공통 기본값은 PROVIDER_MODE이며 개별 값으로 덮어쓸 수 있다.
PROVIDER_MODE=fake
LLM_PROVIDER=fake
WEATHER_PROVIDER=
PLACE_PROVIDER=
GEOCODING_PROVIDER=
CONCENTRATION_PROVIDER=
HOLIDAY_PROVIDER=

# 장소 후보별 상세·운영정보를 어디서 읽을지 고른다: supabase | tour_api
# - supabase: 미리 동기화된 places 테이블을 content_id로 한 번에 조회한다.
#             SUPABASE_URL / SUPABASE_SECRET_KEY가 필요하다.
# - tour_api: 후보마다 상세 API를 호출한다(기본값).
# 장소 후보 "검색"은 이 값과 무관하게 항상 PLACE_PROVIDER를 따른다.
# PLACE_PROVIDER가 fake이면 상세도 Fake Provider가 담당하므로 이 값은 무시된다.
PLACE_DETAILS_SOURCE=tour_api

# LLM_PROVIDER=real일 때 사용할 Gemini 모델명
LLM_MODEL_NAME=gemini-2.5-flash

# 위의 각 Provider를 real로 설정했을 때만 필요한 인증 정보
LLM_API_KEY=
WEATHER_API_KEY=
TOUR_API_SERVICE_KEY=
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

# Supabase 서버 전용 저장소 설정. Secret Key는 프론트엔드에 노출하지 않는다.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Package B의 State(세션 상태·이력·트레이스) 저장소 백엔드: memory | supabase
# - memory: 프로세스 메모리에 저장한다(기본값). 서버 재시작 시 소멸한다.
# - supabase: DB에 영구 저장한다. SUPABASE_URL / SUPABASE_SECRET_KEY가 필요하다.
STATE_STORE_BACKEND=memory

# 장소 동기화 기본값: 서울 종로구
PLACE_SYNC_PAGE_SIZE=100
PLACE_SYNC_DETAIL_CONCURRENCY=5
PLACE_SYNC_DETAIL_TTL_DAYS=30
PLACE_SYNC_AREA_CODE=11
PLACE_SYNC_DISTRICT_CODE=110

# 실제 Provider의 HTTP 동작 설정이며 fake Provider에서는 사용하지 않는다.
EXTERNAL_API_TIMEOUT_SECONDS=10
EXTERNAL_API_RETRY_COUNT=2

# 추천 파이프라인 후보 예산 (MVP 기본값, 필요 시 조정 가능)
RECOMMENDATION_RESULT_LIMIT=5
RECOMMENDATION_CANDIDATE_LIMIT=10

# Fake Provider에서 사용할 고정 날씨 상태: good | neutral | bad
# 비워두면 FakeWeatherProvider가 상태를 순환하거나 neutral을 기본값으로 사용한다.
FAKE_WEATHER_CONDITION=neutral

# PLACE_PROVIDER=fake일 때 추천 로직이 현재 시각으로 사용할 값
# app/core/clock.py에서 사용하며 시간대 없는 ISO 8601 형식으로 입력한다.
# PLACE_PROVIDER=real이면 실제 시각을 사용하므로 이 값은 무시된다.
# Fake 추천 결과를 재현할 수 있도록 장소가 운영 중인 평일 낮 시간으로 고정한다.
FAKE_CURRENT_DATETIME=2026-07-15T14:00:00
