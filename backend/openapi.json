{
  "openapi": "3.1.0",
  "info": {
    "title": "TripBranch API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Get Health",
        "operationId": "get_health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/interpret": {
      "post": {
        "tags": [
          "interpret"
        ],
        "summary": "Interpret User Input",
        "operationId": "interpret_user_input_api_interpret_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InterpretRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InterpretResponse"
                }
              }
            }
          },
          "default": {
            "description": "Common error envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/recommendations": {
      "post": {
        "tags": [
          "recommendations"
        ],
        "summary": "Get Recommendations",
        "operationId": "get_recommendations_api_recommendations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecommendationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendationResponse"
                }
              }
            }
          },
          "default": {
            "description": "Common error envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EnvironmentType": {
        "type": "string",
        "enum": [
          "indoor",
          "outdoor",
          "mixed",
          "unknown"
        ],
        "title": "EnvironmentType"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "invalid_request",
              "location_not_found",
              "location_ambiguous",
              "llm_interpretation_failed",
              "weather_unavailable",
              "place_provider_unavailable",
              "recommendation_not_found",
              "internal_server_error"
            ],
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "retryable": {
            "type": "boolean",
            "title": "Retryable",
            "default": false
          },
          "details": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "ok"
          }
        },
        "type": "object",
        "title": "HealthResponse"
      },
      "InterpretRequest": {
        "properties": {
          "user_input": {
            "type": "string",
            "minLength": 1,
            "title": "User Input"
          }
        },
        "type": "object",
        "required": [
          "user_input"
        ],
        "title": "InterpretRequest"
      },
      "InterpretResponse": {
        "properties": {
          "location_query": {
            "type": "string",
            "title": "Location Query"
          },
          "preferred_categories": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Preferred Categories"
          },
          "weather_condition": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WeatherCondition"
              },
              {
                "type": "null"
              }
            ]
          },
          "search_radius_km": {
            "type": "number",
            "title": "Search Radius Km",
            "default": 1.0
          }
        },
        "type": "object",
        "required": [
          "location_query",
          "preferred_categories",
          "weather_condition"
        ],
        "title": "InterpretResponse"
      },
      "RecommendationItem": {
        "properties": {
          "place_id": {
            "type": "string",
            "title": "Place Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "distance_km": {
            "type": "number",
            "title": "Distance Km"
          },
          "remaining_minutes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Remaining Minutes"
          },
          "environment_type": {
            "$ref": "#/components/schemas/EnvironmentType"
          },
          "recommendation_reason": {
            "type": "string",
            "title": "Recommendation Reason"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "total_score": {
            "type": "number",
            "title": "Total Score"
          },
          "score_breakdown": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Score Breakdown"
          }
        },
        "type": "object",
        "required": [
          "place_id",
          "name",
          "category",
          "distance_km",
          "remaining_minutes",
          "environment_type",
          "recommendation_reason",
          "warnings",
          "total_score",
          "score_breakdown"
        ],
        "title": "RecommendationItem"
      },
      "RecommendationRequest": {
        "properties": {
          "location_query": {
            "type": "string",
            "minLength": 1,
            "title": "Location Query"
          },
          "preferred_categories": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Preferred Categories"
          },
          "weather_condition": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WeatherCondition"
              },
              {
                "type": "null"
              }
            ]
          },
          "search_radius_km": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Search Radius Km",
            "default": 1.0
          },
          "shown_place_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Shown Place Ids"
          }
        },
        "type": "object",
        "required": [
          "location_query"
        ],
        "title": "RecommendationRequest"
      },
      "RecommendationResponse": {
        "properties": {
          "recommendations": {
            "items": {
              "$ref": "#/components/schemas/RecommendationItem"
            },
            "type": "array",
            "title": "Recommendations"
          },
          "unverified_recommendations": {
            "items": {
              "$ref": "#/components/schemas/RecommendationItem"
            },
            "type": "array",
            "title": "Unverified Recommendations"
          }
        },
        "type": "object",
        "required": [
          "recommendations",
          "unverified_recommendations"
        ],
        "title": "RecommendationResponse"
      },
      "WeatherCondition": {
        "type": "string",
        "enum": [
          "good",
          "neutral",
          "bad"
        ],
        "title": "WeatherCondition"
      }
    }
  }
}