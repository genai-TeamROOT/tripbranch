# 선택 항목입니다. 비워두면 API 클라이언트는 동일 출처의 "/api"를 사용합니다.
# 로컬에서는 Vite 개발 서버 프록시를 사용하고, 배포 후에는 같은 도메인 라우팅을 기대합니다.
VITE_API_BASE_URL=

# 채팅 흐름 안에서 구조화된 입력 해석 디버그 카드를 표시합니다.
# 릴리즈 빌드에서는 false로 설정하세요.
VITE_SHOW_INTERPRETATION_DEBUG=true

# 로컬 개발/자동화 브라우저 전용 고정 위치입니다. 설정하면 브라우저 위치 권한 팝업을
# 건너뛰고 이 좌표를 사용합니다. 배포 빌드에서는 무시됩니다. 예: 종로구 경복궁 인근
VITE_TEST_DEVICE_LOCATION=
